    <span class="brand">Hi-Story<span class="badge">Admin</span></span>
    <button type="button" id="menu-close" aria-label="Tutup menu">&times;</button>
  </div>

  <p class="side-title">Masuk sebagai <%= admin.username %></p>

  <nav class="side-links">

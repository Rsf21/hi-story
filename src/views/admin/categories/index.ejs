<%- include('../partials/admin-header') %>

<h1>Kelola Kategori</h1>

<form action="<%= adminPath %>/categories" method="POST" class="form" style="margin-bottom:1.5rem">
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <label>Nama kategori baru</label>
  <input type="text" name="name" placeholder="Misal: Perang Dingin" required>
  <p><button type="submit" class="btn">+ Tambah</button></p>
</form>

<table>
  <thead>
    <tr><th>Nama</th><th>Slug</th><th>Jumlah cerita</th><th>Aksi</th></tr>
  </thead>
  <tbody>
    <% if (categories.length === 0) { %>
      <tr><td colspan="4">Belum ada kategori.</td></tr>
    <% } %>
    <% categories.forEach(c => { %>
      <tr>
        <td><%= c.name %></td>
        <td><%= c.slug %></td>
        <td><%= c.total_stories %></td>
        <td>
          <form action="<%= adminPath %>/categories/<%= c.id %>/delete" method="POST" class="inline"
                onsubmit="return confirm('Hapus kategori ini?')">
            <button type="submit" class="btn btn-danger">Hapus</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/admin-footer') %>
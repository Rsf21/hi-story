<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <style>
    body { font-family: sans-serif; background: #f4f4f4; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
    form { background: #fff; padding: 2rem; border-radius: 8px; width: 320px; box-shadow: 0 2px 8px rgba(0,0,0,.1); }
    input, button { width: 100%; padding: .6rem; margin-top: .5rem; box-sizing: border-box; }
    button { background: #222; color: #fff; border: 0; cursor: pointer; }
    .error { color: #c00; margin-top: .5rem; }
  </style>
</head>
<body>
  <form action="<%= adminPath %>/login" method="POST">
    <h2>Login Admin</h2>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <input type="text" name="username" placeholder="Username" required>
    <input type="password" name="password" placeholder="Password" required>
    <button type="submit">Masuk</button>
  </form>
</body>
</html>
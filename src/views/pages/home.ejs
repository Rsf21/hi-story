
<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main>
  <div class="section-head">
    <div>
      <p class="eyebrow">Arsip Pengetahuan</p>
      <h1 class="section-title">Menelusuri Jejak Sejarah</h1>
    </div>
  </div>

  <form class="story-filter" action="/" method="GET">
    <div class="story-filter-field">
      <label for="filter-location">Lokasi / Negara / Wilayah</label>
      <select id="filter-location" name="location">
        <option value="">Semua Lokasi</option>
        <% locations.forEach(location => { %>
          <option
            value="<%= location.id %>"
            <%= selectedLocation === String(location.id) ? 'selected' : '' %>
          >
            <%= location.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="story-filter-field">
      <label for="filter-year">Tahun</label>
      <input
        type="number"
        id="filter-year"
        name="year"
        placeholder="Contoh: -399 atau 1200"
        value="<%= selectedYear %>"
        step="1"
      >
      <small>Gunakan angka negatif untuk tahun Sebelum Masehi.</small>
    </div>

    <div class="story-filter-field">
      <label for="filter-category">Kategori</label>
      <select id="filter-category" name="category">
        <option value="">Semua Kategori</option>
        <% categories.forEach(category => { %>
          <option
            value="<%= category.slug %>"
            <%= selectedCategory === category.slug ? 'selected' : '' %>
          >
            <%= category.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="story-filter-actions">
      <button type="submit" class="filter-submit">
        Terapkan Filter
      </button>

      <a href="/" class="filter-reset">
        Reset
      </a>
    </div>
  </form>

  <% if (stories.length === 0) { %>
    <div class="empty-stories">
      <h2>Tidak ada cerita ditemukan</h2>
      <p>Coba ubah lokasi, tahun, atau kategori yang dipilih.</p>
      <a href="/">Tampilkan semua cerita</a>
    </div>
  <% } else { %>

    <% const rows = [[], []]; %>

    <% stories.forEach((story, index) => {
      rows[index % 2].push(story);
    }); %>

    <% rows.forEach((row, index) => { %>
      <% if (row.length > 0) { %>
        <div class="rail-row">
          <button
            type="button"
            class="rail-btn prev"
            aria-label="Geser ke kiri"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6"/>
            </svg>
          </button>

          <div
            class="rail"
            tabindex="0"
            aria-label="Cerita baris <%= index === 0 ? 'atas' : 'bawah' %>, geser ke samping"
          >
            <% row.forEach(story => { %>
              <%- include('../partials/card', { story }) %>
            <% }) %>
          </div>

          <button
            type="button"
            class="rail-btn next"
            aria-label="Geser ke kanan"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </button>
        </div>
      <% } %>
    <% }) %>

  <% } %>

  <%- include('../partials/pagination') %>
</main>

<script src="/js/home.js" defer></script>

<%- include('../partials/footer') %>

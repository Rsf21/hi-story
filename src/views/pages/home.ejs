
<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main>
  <div class="section-head">
    <div>
      <p class="eyebrow">Jelajahi</p>
      <h1 class="section-title">Cerita Terbaru</h1>
    </div>

    <p class="section-sub">
      Geser tiap baris ke samping untuk melihat cerita lainnya
    </p>
  </div>

  <% if (stories.length === 0) { %>
    <p>Belum ada cerita.</p>
  <% } else { %>

    <% const rows = [[], []]; %>
    <% stories.forEach((story, index) => {
      rows[index % 2].push(story);
    }); %>

    <% rows.forEach((row, index) => { %>

      <% if (row.length > 0) { %>
        <div class="rail-row">

          <button
            type="button"
            class="rail-btn prev"
            aria-label="Geser ke kiri"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6"/>
            </svg>
          </button>

          <div
            class="rail"
            tabindex="0"
            aria-label="Cerita baris <%= index === 0 ? 'atas' : 'bawah' %>, geser ke samping"
          >

            <% row.forEach(story => { %>
              <%- include('../partials/card', { story }) %>
            <% }) %>

          </div>

          <button
            type="button"
            class="rail-btn next"
            aria-label="Geser ke kanan"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </button>

        </div>
      <% } %>

    <% }) %>

  <% } %>

  <%- include('../partials/pagination') %>

</main>

<script src="/js/home.js" defer></script>

<%- include('../partials/footer') %>

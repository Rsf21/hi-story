<main>
  <section class="nf" aria-labelledby="nf-heading">
    <div class="nf-text">
      <p class="eyebrow">Kesalahan 404</p>
      <h1 id="nf-heading" class="nf-title">Halaman yang <em>kamu cari</em> tidak ada</h1>
      <p class="nf-lead">Bahkan seorang sarjana Athena dengan kaca pembesarnya belum menemukan halaman yang kamu cari. Mungkin alamatnya salah ketik, atau ceritanya sudah dipindahkan.</p>

      <div class="nf-actions">
        <a class="btn-link" href="/">Kembali ke beranda</a>
        <a class="btn-ghost" href="/bumi">Jelajah Bumi</a>
      </div>

      <% if (typeof categories !== 'undefined' && categories.length) { %>
        <div class="nf-cats">
          <p>Atau mulai dari kategori</p>
          <ul>
            <% categories.forEach(c => { %>
              <li><a href="/story/category/<%= c.slug %>"><%= c.name %></a></li>
            <% }) %>
          </ul>
        </div>
      <% } %>
    </div>


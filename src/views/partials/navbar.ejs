
<%
  const u = typeof user !== 'undefined' ? user : null;
  const here = typeof currentPath !== 'undefined' ? currentPath : '/';
  const pathOnly = String(here).split('?')[0];
  const isOn = (p) => (p === '/' ? pathOnly === '/' : pathOnly === p || pathOnly.startsWith(p + '/'));
  const savedCount = typeof savedIds !== 'undefined' ? savedIds.length : 0;
%>

<header class="site-header">
  <div class="nav">

    <a href="/" class="brand" translate="no">Hi-Story</a>

    <div class="nav-tools">

      <% if (u) { %>
        <div class="user" id="user">
          <button
            type="button"
            class="user-btn"
            id="user-btn"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label="Menu akun"
          >
            <% if (u.avatar) { %>
              <img src="<%= u.avatar %>" alt="" referrerpolicy="no-referrer">
            <% } else { %>
              <span class="ph notranslate" translate="no"><%= u.name.charAt(0).toUpperCase() %></span>
            <% } %>
          </button>

          <div class="user-menu" id="user-menu" role="menu" hidden>
            <div class="um-head">
              <span class="um-name notranslate" translate="no"><%= u.name %></span>
              <span class="um-mail notranslate" translate="no"><%= u.email %></span>
            </div>

            <a href="/mybookmarks" role="menuitem">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"/>
              </svg>
              Bookmark saya
            </a>

            <form action="/auth/logout" method="POST">
              <input type="hidden" name="next" value="<%= here %>">

              <button type="submit" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
                </svg>
                Keluar
              </button>
            </form>
          </div>
        </div>
      <% } else { %>
        <a class="login-btn" href="/auth/google?next=<%= encodeURIComponent(here) %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>
          </svg>
          <span>Masuk</span>
        </a>
      <% } %>

      <div class="lang notranslate" id="lang" translate="no">
        <button
          type="button"
          class="lang-btn"
          id="lang-btn"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-label="Pilih bahasa"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
            <path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/>
          </svg>
          <span id="lang-code">ID</span>
        </button>

        <ul class="lang-menu" id="lang-menu" role="listbox" hidden>
          <li><button type="button" data-lang="id">Indonesia</button></li>
          <li><button type="button" data-lang="en">English</button></li>
          <li><button type="button" data-lang="ar">العربية</button></li>
          <li><button type="button" data-lang="zh-CN">中文</button></li>
          <li><button type="button" data-lang="ja">日本語</button></li>
          <li><button type="button" data-lang="ko">한국어</button></li>
          <li><button type="button" data-lang="es">Español</button></li>
          <li><button type="button" data-lang="fr">Français</button></li>
          <li><button type="button" data-lang="de">Deutsch</button></li>
          <li><button type="button" data-lang="ru">Русский</button></li>
        </ul>
      </div>

      <button
        class="theme-toggle"
        id="theme-toggle"
        type="button"
        aria-label="Ganti mode gelap"
        aria-pressed="false"
      >
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
        </svg>

        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
      </button>

    </div>
  </div>
</header>

<div id="google_translate_element" class="gt-hidden" translate="no"></div>

<nav class="bottom-nav" aria-label="Navigasi utama">

  <a
    href="/"
    class="bottom-nav-item <%= isOn('/') ? 'active' : '' %>"
    <%- isOn('/') ? 'aria-current="page"' : '' %>
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m3 10 9-7 9 7"/>
      <path d="M5 9v12h14V9"/>
      <path d="M9 21v-7h6v7"/>
    </svg>
    <span>Beranda</span>
  </a>

  <a
    href="/bumi"
    class="bottom-nav-item <%= isOn('/bumi') ? 'active' : '' %>"
    <%- isOn('/bumi') ? 'aria-current="page"' : '' %>
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9"/>
      <path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/>
    </svg>
    <span>Jelajah</span>
  </a>

  <a
    href="/mybookmarks"
    class="bottom-nav-item <%= isOn('/mybookmarks') ? 'active' : '' %>"
    <%- isOn('/mybookmarks') ? 'aria-current="page"' : '' %>
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"/>
    </svg>
    <span>Bookmark</span>
    <% if (u && savedCount > 0) { %>
      <span class="bottom-nav-count" data-bm-count><%= savedCount %></span>
    <% } %>
  </a>

  <a
    href="/tentang"
    class="bottom-nav-item <%= isOn('/tentang') ? 'active' : '' %>"
    <%- isOn('/tentang') ? 'aria-current="page"' : '' %>
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9"/>
      <path d="M12 11v5M12 8h.01"/>
    </svg>
    <span>Tentang</span>
  </a>

  <a
    href="/kontak"
    class="bottom-nav-item <%= isOn('/kontak') ? 'active' : '' %>"
    <%- isOn('/kontak') ? 'aria-current="page"' : '' %>
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2"/>
      <path d="m3 7 9 6 9-6"/>
    </svg>
    <span>Kontak</span>
  </a>

</nav>

<script>
(function () {
  'use strict';

  var root = document.documentElement;
  var themeBtn = document.getElementById('theme-toggle');

  if (themeBtn) {
    function syncTheme() {
      themeBtn.setAttribute(
        'aria-pressed',
        root.getAttribute('data-theme') === 'dark'
      );
    }

    themeBtn.addEventListener('click', function () {
      var next = root.getAttribute('data-theme') === 'dark'
        ? 'light'
        : 'dark';

      root.setAttribute('data-theme', next);

      try {
        localStorage.setItem('histori-theme', next);
      } catch (e) {}

      syncTheme();
    });

    syncTheme();
  }

  function closeDropdowns() {
    document.querySelectorAll('.dropdown[open]').forEach(function (dropdown) {
      dropdown.removeAttribute('open');
    });
  }

  document.addEventListener('click', function (event) {
    document.querySelectorAll('.dropdown[open]').forEach(function (dropdown) {
      if (!dropdown.contains(event.target)) {
        dropdown.removeAttribute('open');
      }
    });
  });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') {
      closeDropdowns();
    }
  });
})();
</script>

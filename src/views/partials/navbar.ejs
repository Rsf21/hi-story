<%
  const u = typeof user !== 'undefined' ? user : null;
  const here = typeof currentPath !== 'undefined' ? currentPath : '/';
  const pathOnly = String(here).split('?')[0];
  const isOn = (p) => (p === '/' ? pathOnly === '/' : pathOnly === p || pathOnly.startsWith(p + '/'));
  const savedCount = typeof savedIds !== 'undefined' ? savedIds.length : 0;
  const cats = typeof categories !== 'undefined' ? categories : [];
%>

<header class="site-header">
  <div class="nav">
    <button class="burger" id="burger" type="button"
            aria-label="Buka menu" aria-expanded="false" aria-controls="side-menu">
      <span></span><span></span><span></span>
    </button>

    <a href="/" class="brand" translate="no">Hi-Story</a>

    <nav class="main-nav" aria-label="Navigasi utama">
      <details class="dropdown">
        <summary>Kategori</summary>
        <div class="dropdown-menu">
          <% cats.forEach(cat => { %>
            <a href="/story/category/<%= cat.slug %>"><%= cat.name %></a>
          <% }) %>
        </div>
      </details>
      <a href="/bumi">Jelajah Bumi</a>
      <a href="/tentang">Tentang</a>
      <a href="/kontak">Kontak</a>
      <a href="/faq">FAQ</a>
      <a href="/mybookmarks">Bookmark</a>
      <a href="https://saweria.co/HiStory26" target="_blank" rel="noopener noreferrer">Dukungan</a>
    </nav>

    <div class="nav-tools">
      <% if (u) { %>
        <div class="user" id="user">
          <button type="button" class="user-btn" id="user-btn" aria-haspopup="menu" aria-expanded="false" aria-label="Menu akun">
            <% if (u.avatar) { %>
              <img src="<%= u.avatar %>" alt="" referrerpolicy="no-referrer">
            <% } else { %>
              <span class="ph notranslate" translate="no"><%= u.name.charAt(0).toUpperCase() %></span>
            <% } %>
          </button>
          <div class="user-menu" id="user-menu" role="menu" hidden>
            <div class="um-head">
              <span class="um-name notranslate" translate="no"><%= u.name %></span>
              <span class="um-mail notranslate" translate="no"><%= u.email %></span>
            </div>
            <a href="/mybookmarks" role="menuitem">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"/></svg>
              Bookmark saya
            </a>
            <form action="/auth/logout" method="POST">
              <input type="hidden" name="next" value="<%= here %>">
              <button type="submit" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                Keluar
              </button>
            </form>
          </div>
        </div>
      <% } else { %>
        <a class="login-btn" href="/auth/google?next=<%= encodeURIComponent(here) %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          <span>Masuk</span>
        </a>
      <% } %>

      <div class="lang notranslate" id="lang" translate="no">
        <button type="button" class="lang-btn" id="lang-btn" aria-haspopup="listbox" aria-expanded="false" aria-label="Pilih bahasa">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>
          <span id="lang-code">ID</span>
        </button>
        <ul class="lang-menu" id="lang-menu" role="listbox" hidden>
          <li><button type="button" data-lang="id">Indonesia</button></li>
          <li><button type="button" data-lang="en">English</button></li>
          <li><button type="button" data-lang="ar">العربية</button></li>
          <li><button type="button" data-lang="zh-CN">中文</button></li>
          <li><button type="button" data-lang="ja">日本語</button></li>
          <li><button type="button" data-lang="ko">한국어</button></li>
          <li><button type="button" data-lang="es">Español</button></li>
          <li><button type="button" data-lang="fr">Français</button></li>
          <li><button type="button" data-lang="de">Deutsch</button></li>
          <li><button type="button" data-lang="ru">Русский</button></li>
        </ul>
      </div>

      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Ganti mode gelap" aria-pressed="false">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>

<div id="google_translate_element" class="gt-hidden" translate="no"></div>
<div class="overlay" id="overlay"></div>

<aside class="side-menu" id="side-menu" aria-hidden="true" aria-label="Menu">
  <div class="mm">
    <% if (u) { %>
      <div class="mm-user">
        <% if (u.avatar) { %>
          <img src="<%= u.avatar %>" alt="" referrerpolicy="no-referrer">
        <% } else { %>
          <span class="ph notranslate" translate="no"><%= u.name.charAt(0).toUpperCase() %></span>
        <% } %>
        <div class="mm-user-text">
          <span class="um-name notranslate" translate="no"><%= u.name %></span>
          <span class="um-mail notranslate" translate="no"><%= u.email %></span>
        </div>
        <form action="/auth/logout" method="POST">
          <input type="hidden" name="next" value="<%= here %>">
          <button type="submit" class="mm-logout">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
            Keluar
          </button>
        </form>
      </div>
    <% } else { %>
      <div class="mm-login">
        <p>Masuk untuk menyimpan cerita dan membukanya kembali kapan saja.</p>
        <a class="mm-google" href="/auth/google?next=<%= encodeURIComponent(here) %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12
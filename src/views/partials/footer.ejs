        aria-label="Gmail"
        title="Gmail"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
          <path d="M1.5 6.8A2.8 2.8 0 0 1 4.3 4h15.4a2.8 2.8 0 0 1 2.8 2.8v10.4a2.8 2.8 0 0 1-2.8 2.8H4.3a2.8 2.8 0 0 1-2.8-2.8V6.8Zm2.1-.4v.3l8.4 6.5 8.4-6.5v-.3a.7.7 0 0 0-.7-.7H4.3a.7.7 0 0 0-.7.7Zm16.8 2.9-7.8 6a1 1 0 0 1-1.2 0l-7.8-6v7.9c0 .4.3.7.7.7h15.4c.4 0 .7-.3.7-.7V9.3Z"/>

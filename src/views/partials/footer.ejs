    </div>

    <p class="footer-copyright">
      &copy; <%= new Date().getFullYear() %> Hi-Story. Seluruh Hak Cipta Dilindungi.
    </p>

  </div>
</footer>

<script src="/reader.js" defer></script>
</body>
</html>

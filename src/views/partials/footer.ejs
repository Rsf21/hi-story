
<%
  const footerGallery = typeof footerStories !== 'undefined'
    ? footerStories
    : (typeof stories !== 'undefined' ? stories : []);

  const galleryImages = footerGallery.filter(story => story.imageUrl);
%>

<footer class="site-footer">

  <% if (galleryImages.length > 0) { %>
    <section class="footer-gallery" aria-label="Galeri cerita Hi-Story">
      <div class="footer-gallery-track">

        <% for (let i = 0; i < 2; i++) { %>
          <div
            class="footer-gallery-group"
            <%= i === 1 ? 'aria-hidden="true"' : '' %>
          >

            <% galleryImages.forEach(story => { %>
              <div class="footer-gallery-card">
                <img
                  src="<%= story.imageUrl %>"
                  alt="<%= i === 0 ? story.title : '' %>"
                  loading="lazy"
                >
              </div>
            <% }) %>

          </div>
        <% } %>

      </div>
    </section>
  <% } %>

  <div class="container">

    <div class="founder-info">
      <strong>Founded By</strong>
      <span>Reza Septa Fauziansyah</span>
    </div>

    <div class="footer-socials">

      <a
        href="https://wa.me/6287775658059"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="WhatsApp"
        title="WhatsApp"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">

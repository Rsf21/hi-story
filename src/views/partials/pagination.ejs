
<% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
  <nav class="pagination">
    <% if (currentPage > 1) { %>
      <a href="<%= baseUrl %>?<%= filterQuery ? filterQuery + '&' : '' %>page=<%= currentPage - 1 %>">
        &laquo; Sebelumnya
      </a>
    <% } %>

    <% for (let i = 1; i <= totalPages; i++) { %>
      <% if (i === currentPage) { %>
        <span class="active"><%= i %></span>
      <% } else { %>
        <a href="<%= baseUrl %>?<%= filterQuery ? filterQuery + '&' : '' %>page=<%= i %>">
          <%= i %>
        </a>
      <% } %>
    <% } %>

    <% if (currentPage < totalPages) { %>
      <a href="<%= baseUrl %>?<%= filterQuery ? filterQuery + '&' : '' %>page=<%= currentPage + 1 %>">
        Berikutnya &raquo;
      </a>
    <% } %>
  </nav>
<% } %>
